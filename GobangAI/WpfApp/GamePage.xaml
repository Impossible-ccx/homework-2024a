<Page x:Class="WpfApp.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage" d:DataContext="{d:DesignInstance local:GamePageView}">
    <Page.DataContext>
        <local:GamePageView/>
    </Page.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>
        <Canvas Grid.Column="0">
            <Button Content="Quit" Height="50" Width="100" Click="Button_Quit" FontSize="20"/>
            <Label Name="P1L" Height="100" Width="100" Canvas.Top="50" Background="Red"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Visible"/>
            <Label Name="P2L" Height="100" Width="100" Canvas.Top="300" Background="Blue"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Hidden"/>
        </Canvas>
        <StackPanel Grid.Column="1">
            <Image Height="175" Source="./Images/player1.png"/>
            <Label Content="{Binding Player1}" Height="50" FontSize="20" HorizontalContentAlignment="Center"/>
            <Label Content="{Binding Player2}" Height="50" FontSize="20" HorizontalContentAlignment="Center"/>
            <Image Height="175" Source="./Images/player2.png"/>
        </StackPanel>
        <Canvas Name="theMap" Grid.Column="2" Height="400" Width="400"/>
    </Grid>
</Page>
