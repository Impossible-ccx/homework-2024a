<Page x:Class="WpfApp.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" 
      Title="StartPage" d:DataContext="{d:DesignInstance local:StartPageView}">
    <Page.DataContext>
        <local:StartPageView/>
    </Page.DataContext>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Label Content="Player1:" Height="40" FontSize="20"/>
            <Label Content="{Binding Player1.Name}" Height="40" FontSize="20"/>
            <Label Content="Player2:" Height="40" FontSize="20"/>
            <Label Content="{Binding Player2.Name}" Height="40" FontSize="20"/>
            <Label Height="40"/>
            <Label Content="Name:" Height="40" FontSize="20"/>
            <Label Content="{Binding PlayerOnClicked.Name}" Height="40" FontSize="20"/>
            <Label Content="Description:" Height="40" FontSize="20"/>
            <Label Content="{Binding PlayerOnClicked.Description}" Height="80" FontSize="15"/>
        </StackPanel>
        <ListBox Grid.Column="1" ItemsSource="{Binding AvailabelPlayers}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock MouseDown="TextBlock_MouseLeftButtonDown" Width="400">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} &#x0a;{1}">
                                <Binding Path="Name"/>
                                <Binding Path="Description"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="380"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Click="SelectP1" Content="Select as player1" Height="70" FontSize="18"/>
                <Button Click="SelectP2" Content="Select as player2" Height="70" FontSize="18" />
            </StackPanel>
            <Button Grid.Row="1" Click="Start_Button" Content="Start!" Height="70" FontSize="18"/>
        </Grid>
    </Grid>
</Page>
